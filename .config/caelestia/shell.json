{
    "appearance": {
        "transparency": {
            "enabled": false
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": true,
            "showOnHover": false
        },
        "clock": {
            "background": false,
            "showDate": true,
            "showIcon": false
        },
        "persistent": true,
        "popouts": {
            "activeWindow": false,
            "statusIcons": true
        },
        "scrollActions": {
            "workspaces": false
        },
        "showOnHover": true,
        "statusIcons": [
            {
                "enabled": true,
                "id": "lockStatus"
            },
            {
                "enabled": true,
                "id": "audio"
            },
            {
                "enabled": true,
                "id": "microphone"
